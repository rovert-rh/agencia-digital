---
// src/components/Navbar.astro
---

<header class="fixed top-5 left-0 right-0 z-50 flex justify-center px-4">
    <!-- Fondo ultra translúcido (20% opacidad) con desenfoque elevado (backdrop-blur-xl) -->
    <nav
        class="flex items-center justify-between w-full max-w-5xl px-6 py-2.5 bg-slate-950/20 dark:bg-slate-950/20 backdrop-blur-xl border border-purple-500/20 rounded-full shadow-[0_0_25px_rgba(168,85,247,0.15)] transition-all"
    >
        <!-- Logo Shift Digital con efecto Tecla -->
        <a href="#" class="flex items-center gap-2 group">
            <div
                class="w-8 h-8 bg-slate-950/60 border border-purple-500/50 rounded-lg flex items-center justify-center shadow-[inset_0_-2px_0_#0f172a] group-hover:border-purple-400 transition-all"
            >
                <span class="text-purple-400 font-mono font-bold text-xs"
                    >&lt;/&gt;</span
                >
            </div>
            <span class="text-white font-bold tracking-wider text-sm"
                >Shift Digital</span
            >
        </a>

        <!-- Rutas / Links centrados -->
        <div
            class="hidden md:flex items-center gap-6 text-xs text-slate-300 font-medium"
        >
            <a href="#servicios" class="hover:text-purple-400 transition-colors"
                >Servicios</a
            >
            <a href="#proceso" class="hover:text-purple-400 transition-colors"
                >Digitalización</a
            >
            <a href="#métricas" class="hover:text-purple-400 transition-colors"
                >Proyectos</a
            >
            <a href="#contacto" class="hover:text-purple-400 transition-colors"
                >Contacto</a
            >
        </div>

        <!-- Acciones: Switch de Tema + Botón CTA -->
        <div class="flex items-center gap-3">
            <!-- Botón CTA con estilo Glow Violeta -->
            <a
                href="#contacto"
                class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all shadow-[0_0_15px_rgba(168,85,247,0.4)] hover:shadow-[0_0_25px_rgba(168,85,247,0.7)] whitespace-nowrap"
            >
                Iniciar proyecto
            </a>
        </div>
    </nav>
</header>

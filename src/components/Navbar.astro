---
// src/components/Navbar.astro
---

<nav
    class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-fit transition-all duration-300"
>
    <!-- Contenedor de la Isla Flotante -->
    <div
        class="flex items-center justify-between gap-4 px-3 py-2 bg-slate-900/40 backdrop-blur-2xl border border-white/10 rounded-full shadow-[0_15px_35px_rgba(0,0,0,0.5)]"
    >
        <!-- Ícono / Inicio (Reemplaza el nombre DVUX) -->
        <a
            href="#"
            class="group flex-shrink-0 w-10 h-10 bg-slate-950 border border-slate-700/50 rounded-full flex items-center justify-center hover:border-cyan-400 hover:bg-cyan-500/10 transition-all shadow-[inset_0_-2px_0_rgba(255,255,255,0.1)]"
        >
            <span
                class="text-cyan-400 font-mono font-bold text-sm group-hover:scale-110 transition-transform"
                >&lt;/&gt;</span
            >
        </a>

        <!-- Enlaces de Navegación (Centrados) -->
        <div
            class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-300"
        >
            <a
                href="#servicios"
                class="px-5 py-2 rounded-full hover:text-white hover:bg-white/10 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] transition-all"
                >Servicios</a
            >
            <a
                href="#proceso"
                class="px-5 py-2 rounded-full hover:text-white hover:bg-white/10 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] transition-all"
                >Proceso</a
            >
        </div>

        <!-- Controles (Tema + Botón de Acción) -->
        <div class="flex items-center gap-2 pl-2 border-l border-white/10">
            <!-- Botón Modo Oscuro / Claro -->
            <button
                id="theme-toggle"
                class="p-2.5 text-slate-400 hover:text-cyan-400 hover:bg-white/10 rounded-full transition-all focus:outline-none"
                aria-label="Cambiar tema"
            >
                <!-- Ícono de Luna (Modo Oscuro) -->
                <svg
                    id="theme-toggle-dark-icon"
                    class="w-5 h-5 hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                    ></path>
                </svg>
                <!-- Ícono de Sol (Modo Claro) -->
                <svg
                    id="theme-toggle-light-icon"
                    class="w-5 h-5 hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                        fill-rule="evenodd"
                        clip-rule="evenodd"></path>
                </svg>
            </button>

            <!-- Botón Iniciar -->
            <a
                href="#contacto"
                class="bg-cyan-500 text-slate-950 px-5 py-2 rounded-full font-bold text-sm hover:bg-cyan-400 hover:scale-105 transition-all shadow-[0_0_15px_rgba(6,182,212,0.4)] hover:shadow-[0_0_25px_rgba(6,182,212,0.8)] whitespace-nowrap"
            >
                Iniciar
            </a>
        </div>
    </div>
</nav>

<!-- Script Funcional para el Cambio de Tema -->
<script>
    const themeToggleDarkIcon = document.getElementById(
        "theme-toggle-dark-icon",
    );
    const themeToggleLightIcon = document.getElementById(
        "theme-toggle-light-icon",
    );
    const themeToggleBtn = document.getElementById("theme-toggle");

    // Evaluar preferencia inicial
    if (
        localStorage.getItem("color-theme") === "dark" ||
        (!("color-theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
        themeToggleLightIcon.classList.remove("hidden");
        document.documentElement.classList.add("dark");
    } else {
        themeToggleDarkIcon.classList.remove("hidden");
        document.documentElement.classList.add("dark"); // Mantenemos oscuro por defecto hasta implementar clases claras
    }

    // Lógica del botón interactivo
    themeToggleBtn.addEventListener("click", function () {
        // Alternar íconos
        themeToggleDarkIcon.classList.toggle("hidden");
        themeToggleLightIcon.classList.toggle("hidden");

        // Alternar clases en el HTML
        if (document.documentElement.classList.contains("dark")) {
            document.documentElement.classList.remove("dark");
            localStorage.setItem("color-theme", "light");
        } else {
            document.documentElement.classList.add("dark");
            localStorage.setItem("color-theme", "dark");
        }
    });
</script>

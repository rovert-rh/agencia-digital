---
// src/components/Navbar.astro
---

<header class="fixed top-5 left-0 right-0 z-50 flex justify-center px-4">
    <!-- Fondo ultra translúcido (20% opacidad) con desenfoque elevado (backdrop-blur-xl) -->
    <nav
        class="flex items-center justify-between w-full max-w-5xl px-6 py-2.5 bg-slate-950/20 dark:bg-slate-950/20 backdrop-blur-xl border border-purple-500/20 rounded-full shadow-[0_0_25px_rgba(168,85,247,0.15)] transition-all"
    >
        <!-- Logo Shift Digital con efecto Tecla -->
        <a href="#" class="flex items-center gap-2 group">
            <div
                class="w-8 h-8 bg-slate-950/60 border border-purple-500/50 rounded-lg flex items-center justify-center shadow-[inset_0_-2px_0_#0f172a] group-hover:border-purple-400 transition-all"
            >
                <span class="text-purple-400 font-mono font-bold text-xs"
                    >&lt;/&gt;</span
                >
            </div>
            <span class="text-white font-bold tracking-wider text-sm"
                >Shift Digital</span
            >
        </a>

        <!-- Rutas / Links centrados -->
        <div
            class="hidden md:flex items-center gap-6 text-xs text-slate-300 font-medium"
        >
            <a href="#servicios" class="hover:text-purple-400 transition-colors"
                >Servicios</a
            >
            <a href="#proceso" class="hover:text-purple-400 transition-colors"
                >Digitalización</a
            >
            <a href="#métricas" class="hover:text-purple-400 transition-colors"
                >Proyectos</a
            >
            <a href="#contacto" class="hover:text-purple-400 transition-colors"
                >Contacto</a
            >
        </div>

        <!-- Acciones: Switch de Tema + Botón CTA -->
        <div class="flex items-center gap-3">
            <!-- BOTÓN SWITCH MODO OSCURO / CLARO -->
            <button
                id="theme-toggle"
                type="button"
                class="p-2 text-slate-400 hover:text-purple-300 hover:bg-white/5 rounded-full transition-all focus:outline-none"
                aria-label="Cambiar tema"
            >
                <!-- Ícono Luna (Visible en modo claro para pasar a oscuro) -->
                <svg
                    id="theme-toggle-dark-icon"
                    class="w-4 h-4 hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                    ></path>
                </svg>
                <!-- Ícono Sol (Visible en modo oscuro para pasar a claro) -->
                <svg
                    id="theme-toggle-light-icon"
                    class="w-4 h-4 hidden"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                        fill-rule="evenodd"
                        clip-rule="evenodd"></path>
                </svg>
            </button>

            <!-- Botón CTA con estilo Glow Violeta -->
            <a
                href="#contacto"
                class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-full transition-all shadow-[0_0_15px_rgba(168,85,247,0.4)] hover:shadow-[0_0_25px_rgba(168,85,247,0.7)] whitespace-nowrap"
            >
                Iniciar proyecto
            </a>
        </div>
    </nav>
</header>

<!-- Script para la lógica del cambio de tema -->
<script>
    const themeToggleDarkIcon = document.getElementById(
        "theme-toggle-dark-icon",
    );
    const themeToggleLightIcon = document.getElementById(
        "theme-toggle-light-icon",
    );
    const themeToggleBtn = document.getElementById("theme-toggle");

    // Verificar la preferencia de tema guardada o del sistema
    if (
        localStorage.getItem("color-theme") === "light" ||
        (!("color-theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: light)").matches)
    ) {
        themeToggleDarkIcon?.classList.remove("hidden");
        document.documentElement.classList.remove("dark");
    } else {
        themeToggleLightIcon?.classList.remove("hidden");
        document.documentElement.classList.add("dark");
    }

    // Evento al hacer clic en el botón
    themeToggleBtn?.addEventListener("click", function () {
        themeToggleDarkIcon?.classList.toggle("hidden");
        themeToggleLightIcon?.classList.toggle("hidden");

        if (document.documentElement.classList.contains("dark")) {
            document.documentElement.classList.remove("dark");
            localStorage.setItem("color-theme", "light");
        } else {
            document.documentElement.classList.add("dark");
            localStorage.setItem("color-theme", "dark");
        }
    });
</script>

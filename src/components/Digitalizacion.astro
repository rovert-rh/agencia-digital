---
// src/components/Digitalizacion.astro
---

<section
    id="proceso"
    class="relative py-32 z-10 bg-slate-950 border-t border-white/5 overflow-hidden min-h-screen flex flex-col justify-center"
>
    <!-- ========================================== -->
    <!-- CAPA DE FONDO 2D DINÁMICO Y LLAMATIVO       -->
    <!-- ========================================== -->
    <div class="absolute inset-0 pointer-events-none z-0">
        <!-- 1. Cuadrícula (Grid) animada -->
        <div class="absolute inset-0 bg-grid opacity-20"></div>

        <!-- 2. Orbes de Neón en movimiento continuo -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden">
            <div
                class="orbe orbe-cyan absolute -top-[10%] -left-[10%] w-[50vw] h-[50vw] rounded-full blur-[150px] mix-blend-screen opacity-40"
            >
            </div>
            <div
                class="orbe orbe-purple absolute top-[40%] right-[10%] w-[40vw] h-[40vw] rounded-full blur-[150px] mix-blend-screen opacity-40"
            >
            </div>
            <div
                class="orbe orbe-blue absolute -bottom-[20%] left-[20%] w-[60vw] h-[60vw] rounded-full blur-[150px] mix-blend-screen opacity-30"
            >
            </div>
        </div>

        <!-- 3. Lluvia de símbolos y teclas en todo el contenedor -->
        <div class="lluvia-teclas">
            <span class="p1 text-cyan-500/20 font-mono text-4xl">Ctrl</span>
            <span class="p2 text-purple-500/20 font-mono text-2xl"
                >&lt;/&gt;</span
            >
            <span class="p3 text-slate-500/20 font-mono text-5xl">Shift</span>
            <span class="p4 text-cyan-400/20 font-mono text-3xl">{}</span>
            <span class="p5 text-purple-400/20 font-mono text-4xl">Alt</span>
            <span class="p6 text-slate-600/30 font-mono text-2xl">[]</span>
            <span class="p7 text-cyan-500/20 font-mono text-6xl">Esc</span>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- CONTENIDO DEL TIMELINE (GLASSMORPHISM)      -->
    <!-- ========================================== -->
    <div class="max-w-6xl mx-auto px-6 relative z-10 w-full">
        <!-- Encabezado con efecto de brillo -->
        <div class="text-center mb-24 relative">
            <h2
                class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight"
            >
                Tu evolución <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-cyan-400 to-blue-500 animate-gradient-x"
                    >Paso a Paso</span
                >
            </h2>
            <p
                class="text-slate-300 max-w-2xl mx-auto text-lg md:text-xl font-medium drop-shadow-md"
            >
                El proceso exacto de cómo tomamos tu local físico y lo
                convertimos en una máquina de ventas digital.
            </p>
        </div>

        <!-- Timeline Wrapper -->
        <div class="relative">
            <!-- Línea central brillante -->
            <div
                class="absolute left-8 md:left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-cyan-400 via-purple-500 to-transparent -translate-x-1/2 shadow-[0_0_25px_rgba(6,182,212,0.8)]"
            >
            </div>

            <!-- Paso 1 -->
            <div
                class="relative flex flex-col md:flex-row justify-between items-center w-full mb-24 group"
            >
                <div class="hidden md:block w-[45%] text-right">
                    <!-- Tarjeta de cristal super translúcida -->
                    <div
                        class="bg-slate-900/30 backdrop-blur-xl p-8 rounded-2xl border border-white/10 hover:border-cyan-400/50 hover:bg-slate-900/50 transition-all duration-500 shadow-[0_8px_30px_rgb(0,0,0,0.5)]"
                    >
                        <h3
                            class="text-2xl font-bold text-white mb-3 group-hover:text-cyan-400 transition-colors"
                        >
                            1. Diagnóstico Análogo
                        </h3>
                        <p class="text-slate-300 leading-relaxed">
                            Analizamos tu modelo de negocio actual. Entendemos
                            qué vendes, cómo cobras y quiénes son tus clientes
                            de mostrador.
                        </p>
                    </div>
                </div>

                <!-- Tecla Timeline -->
                <div
                    class="absolute left-8 md:left-1/2 -translate-x-1/2 w-16 h-16 bg-slate-950 border-2 border-cyan-500 rounded-xl flex items-center justify-center z-10 shadow-[0_0_20px_rgba(6,182,212,0.6)] group-hover:scale-110 group-hover:bg-cyan-500 transition-all duration-300"
                >
                    <span
                        class="text-cyan-400 font-mono font-bold text-sm group-hover:text-slate-950"
                        >Esc</span
                    >
                </div>

                <div class="w-full pl-28 md:hidden">
                    <div
                        class="bg-slate-900/30 backdrop-blur-xl p-6 rounded-xl border border-white/10 shadow-xl"
                    >
                        <h3 class="text-xl font-bold text-cyan-400 mb-2">
                            1. Diagnóstico Análogo
                        </h3>
                        <p class="text-slate-300 text-sm">
                            Analizamos tu modelo de negocio actual y tus
                            clientes físicos.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Paso 2 -->
            <div
                class="relative flex flex-col md:flex-row justify-between items-center w-full mb-24 group"
            >
                <div class="w-full pl-28 md:w-[45%] md:hidden mt-4">
                    <div
                        class="bg-slate-900/30 backdrop-blur-xl p-6 rounded-xl border border-white/10 shadow-xl"
                    >
                        <h3 class="text-xl font-bold text-purple-400 mb-2">
                            2. Identidad y Redes
                        </h3>
                        <p class="text-slate-300 text-sm">
                            Creamos tus perfiles profesionales para que la gente
                            de tu zona te encuentre en internet.
                        </p>
                    </div>
                </div>

                <div
                    class="absolute left-8 md:left-1/2 -translate-x-1/2 w-16 h-16 bg-slate-950 border-2 border-purple-500 rounded-xl flex items-center justify-center z-10 shadow-[0_0_20px_rgba(168,85,247,0.6)] group-hover:scale-110 group-hover:bg-purple-500 transition-all duration-300 md:order-2"
                >
                    <span
                        class="text-purple-400 font-mono font-bold text-sm group-hover:text-slate-950"
                        >F5</span
                    >
                </div>

                <div
                    class="hidden md:block w-[45%] text-left md:order-3 ml-auto"
                >
                    <div
                        class="bg-slate-900/30 backdrop-blur-xl p-8 rounded-2xl border border-white/10 hover:border-purple-400/50 hover:bg-slate-900/50 transition-all duration-500 shadow-[0_8px_30px_rgb(0,0,0,0.5)]"
                    >
                        <h3
                            class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors"
                        >
                            2. Identidad y Redes
                        </h3>
                        <p class="text-slate-300 leading-relaxed">
                            Te ponemos en el mapa. Optimizamos tus perfiles en
                            Google Maps, Facebook e Instagram para que tu local
                            físico exista digitalmente.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Paso 3 -->
            <div
                class="relative flex flex-col md:flex-row justify-between items-center w-full group"
            >
                <div class="hidden md:block w-[45%] text-right">
                    <div
                        class="bg-slate-900/30 backdrop-blur-xl p-8 rounded-2xl border border-white/10 hover:border-blue-400/50 hover:bg-slate-900/50 transition-all duration-500 shadow-[0_8px_30px_rgb(0,0,0,0.5)]"
                    >
                        <h3
                            class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors"
                        >
                            3. Plataforma y Bots
                        </h3>
                        <p class="text-slate-300 leading-relaxed">
                            Lanzamos tu sitio web o e-commerce. Además,
                            conectamos chatbots para que respondan preguntas
                            frecuentes automáticamente.
                        </p>
                    </div>
                </div>

                <div
                    class="absolute left-8 md:left-1/2 -translate-x-1/2 w-20 h-16 bg-slate-950 border-2 border-blue-500 rounded-xl flex items-center justify-center z-10 shadow-[0_0_20px_rgba(59,130,246,0.6)] group-hover:scale-110 group-hover:bg-blue-500 transition-all duration-300"
                >
                    <span
                        class="text-blue-400 font-mono font-bold text-sm flex flex-col items-center leading-none group-hover:text-slate-950"
                    >
                        <span>Enter</span>
                    </span>
                </div>

                <div class="w-full pl-28 md:hidden">
                    <div
                        class="bg-slate-900/30 backdrop-blur-xl p-6 rounded-xl border border-white/10 shadow-xl"
                    >
                        <h3 class="text-xl font-bold text-blue-400 mb-2">
                            3. Plataforma y Bots
                        </h3>
                        <p class="text-slate-300 text-sm">
                            Lanzamos tu página web, tienda online y
                            automatizamos tus respuestas con chatbots.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* 1. Fondo de Cuadrícula Tecnológica */
    .bg-grid {
        background-size: 50px 50px;
        background-image:
            linear-gradient(
                to right,
                rgba(255, 255, 255, 0.05) 1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                rgba(255, 255, 255, 0.05) 1px,
                transparent 1px
            );
        animation: pan-grid 20s linear infinite;
    }
    @keyframes pan-grid {
        0% {
            transform: translateY(0);
        }
        100% {
            transform: translateY(50px);
        }
    }

    /* 2. Animación de Orbes de Colores (Auroras) */
    .orbe {
        animation: mover-orbe 15s ease-in-out infinite alternate;
    }
    .orbe-cyan {
        background-color: #06b6d4;
        animation-delay: 0s;
    }
    .orbe-purple {
        background-color: #a855f7;
        animation-delay: -5s;
    }
    .orbe-blue {
        background-color: #3b82f6;
        animation-delay: -10s;
    }

    @keyframes mover-orbe {
        0% {
            transform: translate(0, 0) scale(1);
        }
        50% {
            transform: translate(10vw, 5vh) scale(1.2);
        }
        100% {
            transform: translate(-5vw, -5vh) scale(0.9);
        }
    }

    /* 3. Lluvia de Teclas y Símbolos */
    .lluvia-teclas span {
        position: absolute;
        top: -10%;
        animation: caer 25s linear infinite;
    }
    .p1 {
        left: 10%;
        animation-delay: 0s;
        animation-duration: 20s;
    }
    .p2 {
        left: 30%;
        animation-delay: -5s;
        animation-duration: 25s;
    }
    .p3 {
        left: 50%;
        animation-delay: -12s;
        animation-duration: 22s;
        font-weight: bold;
    }
    .p4 {
        left: 70%;
        animation-delay: -2s;
        animation-duration: 28s;
    }
    .p5 {
        left: 85%;
        animation-delay: -8s;
        animation-duration: 18s;
    }
    .p6 {
        left: 20%;
        animation-delay: -15s;
        animation-duration: 24s;
    }
    .p7 {
        left: 80%;
        animation-delay: -10s;
        animation-duration: 30s;
        font-weight: bold;
    }

    @keyframes caer {
        0% {
            transform: translateY(0) rotate(0deg);
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        90% {
            opacity: 1;
        }
        100% {
            transform: translateY(120vh) rotate(360deg);
            opacity: 0;
        }
    }

    /* Utilidad extra para el gradiente del título */
    .animate-gradient-x {
        background-size: 200% 200%;
        animation: gradiente-texto 5s ease infinite;
    }
    @keyframes gradiente-texto {
        0%,
        100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }
</style>

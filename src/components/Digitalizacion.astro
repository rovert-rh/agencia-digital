---
// src/components/Digitalizacion.astro
---

<section
    id="proceso"
    class="relative py-28 bg-slate-950 overflow-hidden border-t border-purple-500/10"
>
    <!-- FONDOS Y EFECTOS DE LUZ -->
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 bg-grid-purple opacity-10"></div>
        <div
            class="absolute top-1/2 left-0 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-purple-900/20 via-indigo-900/10 to-transparent blur-[160px] rounded-full"
        >
        </div>
    </div>

    <!-- Ajustado a max-w-6xl para mantener la simetría en toda la landing page -->
    <div class="relative z-10 max-w-6xl mx-auto px-6">
        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="text-center mb-16">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-purple-950/50 border border-purple-500/20 backdrop-blur-md"
            >
                <span class="text-xs text-purple-300 font-mono"
                    >F5 + Evolution</span
                >
                <span class="text-xs text-slate-400">• Proceso Paso a Paso</span
                >
            </div>
            <h2
                class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-4"
            >
                Tu ruta de transición <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-indigo-300 to-cyan-300"
                >
                    de lo Análogo a lo Digital.
                </span>
            </h2>
            <p class="text-slate-400 max-w-xl mx-auto text-sm md:text-base">
                Estructuramos la migración de tu negocio en una secuencia clara
                de 3 pasos sin interrumpir tus ventas diarias.
            </p>
        </div>

        <!-- LISTA CON DIFUMINADO VERTICAL EN CONTENEDOR ANCHO -->
        <div class="flex flex-col gap-6 relative">
            <!-- PASO 1 (Cyan) -->
            <div
                class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/50 to-slate-950/30 backdrop-blur-md rounded-[2rem] p-6 md:p-8 border border-white/10 hover:border-cyan-500/40 transition-all duration-500 hover:-translate-y-1 overflow-hidden shadow-2xl"
            >
                <!-- Glow Neón Superior y Difuminado Inferior -->
                <div
                    class="absolute top-0 right-0 w-48 h-48 bg-cyan-500/15 blur-3xl rounded-full group-hover:bg-cyan-500/30 transition-all duration-500"
                >
                </div>
                <div
                    class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent pointer-events-none"
                >
                </div>

                <div
                    class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
                >
                    <div class="flex items-center gap-6">
                        <!-- Número estilizado -->
                        <span
                            class="text-4xl font-extrabold font-mono text-cyan-400/40 group-hover:text-cyan-400 transition-colors"
                            >01</span
                        >

                        <!-- Tecla -->
                        <div
                            class="w-12 h-12 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center shadow-[inset_0_-2px_0_#1e293b] flex-shrink-0"
                        >
                            <span
                                class="text-cyan-400 font-mono font-bold text-xs"
                                >Esc</span
                            >
                        </div>

                        <div>
                            <h3
                                class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors"
                            >
                                Diagnóstico Análogo
                            </h3>
                            <p
                                class="text-slate-400 text-sm mt-1 max-w-xl leading-relaxed"
                            >
                                Evaluamos tu punto de venta actual, la dinámica
                                con tus clientes físicos y tus productos
                                principales para diseñar el plan de migración.
                            </p>
                        </div>
                    </div>

                    <span
                        class="text-xs font-mono text-cyan-400 bg-cyan-950/60 border border-cyan-800/40 px-3.5 py-1.5 rounded-full flex-shrink-0 self-end md:self-center"
                    >
                        Fase 1 • Inicio
                    </span>
                </div>
            </div>

            <!-- PASO 2 (Púrpura) -->
            <div
                class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/50 to-slate-950/30 backdrop-blur-md rounded-[2rem] p-6 md:p-8 border border-white/10 hover:border-purple-500/40 transition-all duration-500 hover:-translate-y-1 overflow-hidden shadow-2xl"
            >
                <div
                    class="absolute top-0 right-0 w-48 h-48 bg-purple-500/15 blur-3xl rounded-full group-hover:bg-purple-500/30 transition-all duration-500"
                >
                </div>
                <div
                    class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent pointer-events-none"
                >
                </div>

                <div
                    class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
                >
                    <div class="flex items-center gap-6">
                        <span
                            class="text-4xl font-extrabold font-mono text-purple-400/40 group-hover:text-purple-400 transition-colors"
                            >02</span
                        >

                        <div
                            class="w-12 h-12 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center shadow-[inset_0_-2px_0_#1e293b] flex-shrink-0"
                        >
                            <span
                                class="text-purple-400 font-mono font-bold text-xs"
                                >F5</span
                            >
                        </div>

                        <div>
                            <h3
                                class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors"
                            >
                                Presencia & Redes
                            </h3>
                            <p
                                class="text-slate-400 text-sm mt-1 max-w-xl leading-relaxed"
                            >
                                Configuramos tu ficha en Google Maps, perfiles
                                sociales y canal directo de WhatsApp para
                                posicionar tu negocio en la zona.
                            </p>
                        </div>
                    </div>

                    <span
                        class="text-xs font-mono text-purple-400 bg-purple-950/60 border border-purple-800/40 px-3.5 py-1.5 rounded-full flex-shrink-0 self-end md:self-center"
                    >
                        Fase 2 • Configuración
                    </span>
                </div>
            </div>

            <!-- PASO 3 (Indigo) -->
            <div
                class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/50 to-slate-950/30 backdrop-blur-md rounded-[2rem] p-6 md:p-8 border border-white/10 hover:border-indigo-500/40 transition-all duration-500 hover:-translate-y-1 overflow-hidden shadow-2xl"
            >
                <div
                    class="absolute top-0 right-0 w-48 h-48 bg-indigo-500/15 blur-3xl rounded-full group-hover:bg-indigo-500/30 transition-all duration-500"
                >
                </div>
                <div
                    class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent pointer-events-none"
                >
                </div>

                <div
                    class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
                >
                    <div class="flex items-center gap-6">
                        <span
                            class="text-4xl font-extrabold font-mono text-indigo-400/40 group-hover:text-indigo-400 transition-colors"
                            >03</span
                        >

                        <div
                            class="w-12 h-12 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center shadow-[inset_0_-2px_0_#1e293b] flex-shrink-0"
                        >
                            <span
                                class="text-indigo-400 font-mono font-bold text-xs"
                                >Enter</span
                            >
                        </div>

                        <div>
                            <h3
                                class="text-xl font-bold text-white group-hover:text-indigo-300 transition-colors"
                            >
                                Plataforma & Lanzamiento
                            </h3>
                            <p
                                class="text-slate-400 text-sm mt-1 max-w-xl leading-relaxed"
                            >
                                Desplegamos tu plataforma web o e-commerce y
                                conectamos los chatbots para recibir pedidos y
                                consultas automáticamente.
                            </p>
                        </div>
                    </div>

                    <span
                        class="text-xs font-mono text-indigo-400 bg-indigo-950/60 border border-indigo-800/40 px-3.5 py-1.5 rounded-full flex-shrink-0 self-end md:self-center"
                    >
                        Fase 3 • Despliegue
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-grid-purple {
        background-size: 40px 40px;
        background-image:
            linear-gradient(
                to right,
                rgba(168, 85, 247, 0.08) 1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                rgba(168, 85, 247, 0.08) 1px,
                transparent 1px
            );
    }
</style>

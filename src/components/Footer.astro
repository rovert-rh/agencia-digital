---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer
    class="relative z-10 bg-slate-950 border-t border-white/5 py-12 text-slate-400 text-sm"
>
    <div
        class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left"
    >
        <!-- Logo o Identidad -->
        <div class="flex items-center gap-3">
            <div
                class="w-8 h-8 bg-slate-900 border border-cyan-500/50 rounded flex items-center justify-center shadow-[0_0_10px_rgba(6,182,212,0.3)]"
            >
                <span class="text-cyan-400 font-mono font-bold text-xs"
                    >&lt;/&gt;</span
                >
            </div>
            <span class="font-bold tracking-widest text-white">DVUX</span>
            <span class="text-xs text-slate-600 font-mono">© {currentYear}</span
            >
        </div>

        <!-- Enlaces rápidos o aviso -->
        <div class="flex gap-6 text-xs font-mono text-slate-500">
            <a href="#servicios" class="hover:text-cyan-400 transition-colors"
                >Servicios</a
            >
            <a href="#proceso" class="hover:text-cyan-400 transition-colors"
                >Proceso</a
            >
            <a href="#contacto" class="hover:text-cyan-400 transition-colors"
                >Contacto</a
            >
        </div>

        <!-- Cierre de tecla / atajo -->
        <div class="flex items-center gap-2">
            <span
                class="px-2 py-1 bg-slate-900 border border-slate-800 rounded text-xs text-slate-500 font-mono shadow-[inset_0_-2px_0_#020617]"
                >Esc</span
            >
            <span class="text-xs text-slate-600 font-mono">para reiniciar</span>
        </div>
    </div>
</footer>

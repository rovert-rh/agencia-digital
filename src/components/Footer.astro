---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer
    class="relative z-10 bg-slate-950 border-t border-purple-500/10 py-12 text-slate-400 text-xs overflow-hidden"
>
    <!-- Luz ambiental de fondo -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[120px] bg-purple-600/10 blur-[100px] rounded-full"
        >
        </div>
    </div>

    <!-- Alineado con el contenedor general (max-w-6xl) -->
    <div
        class="max-w-6xl mx-auto px-6 relative z-10 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left"
    >
        <!-- Logo e Identidad -->
        <div class="flex items-center gap-3">
            <div
                class="w-8 h-8 bg-slate-950 border border-slate-800 rounded-lg flex items-center justify-center shadow-[inset_0_-2px_0_#1e293b]"
            >
                <span class="text-purple-400 font-mono font-bold text-xs"
                    >&lt;/&gt;</span
                >
            </div>
            <span class="font-bold tracking-wider text-white text-base"
                >Shift Digital</span
            >
            <span class="text-slate-500 font-mono text-xs">© {currentYear}</span
            >
        </div>

        <!-- Enlaces de navegación -->
        <div class="flex items-center gap-6 font-mono text-slate-400 text-xs">
            <a href="#servicios" class="hover:text-purple-300 transition-colors"
                >Servicios</a
            >
            <a href="#proceso" class="hover:text-purple-300 transition-colors"
                >Proceso</a
            >
            <a href="#contacto" class="hover:text-purple-300 transition-colors"
                >Contacto</a
            >
        </div>

        <!-- Atajo de Cierre -->
        <div class="flex items-center gap-2 text-slate-500 font-mono text-xs">
            <span
                class="px-2.5 py-1 bg-slate-900 border border-slate-800 rounded text-purple-400 font-bold shadow-[inset_0_-2px_0_#020617]"
                >Esc</span
            >
            <span>para reiniciar</span>
        </div>
    </div>
</footer>

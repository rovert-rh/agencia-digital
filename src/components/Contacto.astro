---
// src/components/Contacto.astro
const meetLink = "https://calendar.app.google/EzD8M4sdQE9x96oPA";
const whatsappNumber = "525500000000"; // Reemplaza con tu número real
const whatsappMessage =
    "Hola Shift Digital, me interesa digitalizar mi negocio.";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section
    id="contacto"
    class="relative py-28 bg-slate-950 overflow-hidden border-t border-purple-500/10"
>
    <!-- FONDOS Y EFECTOS DE LUZ -->
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 bg-grid-purple opacity-10"></div>
        <div
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-t from-purple-600/20 via-indigo-600/10 to-transparent blur-[160px] rounded-full"
        >
        </div>
    </div>

    <!-- Ajustado a max-w-6xl para alinear con el resto de la página -->
    <div class="relative z-10 max-w-6xl mx-auto px-6">
        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="text-center mb-16">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-purple-950/50 border border-purple-500/20 backdrop-blur-md"
            >
                <span class="text-xs text-purple-300 font-mono"
                    >Ctrl + Space</span
                >
                <span class="text-xs text-slate-400">• Contacto Directo</span>
            </div>
            <h2
                class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-4"
            >
                Iniciemos tu <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-indigo-300 to-cyan-300"
                >
                    Transformación Digital.
                </span>
            </h2>
            <p class="text-slate-400 max-w-xl mx-auto text-sm md:text-base">
                Sin formularios extensos. Elige el canal que prefieras y
                hablemos directamente sobre tu proyecto.
            </p>
        </div>

        <!-- TARJETAS DE CONTACTO EN CONTENEDOR ANCHO -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- OPCIÓN 1: GOOGLE MEET (Púrpura) -->
            <a
                href={meetLink}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/50 to-slate-950/30 backdrop-blur-md rounded-[2rem] p-8 md:p-10 border border-white/10 hover:border-purple-500/40 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden shadow-2xl hover:shadow-purple-500/10"
            >
                <!-- Glow Neón Superior y Difuminado Inferior -->
                <div
                    class="absolute top-0 right-0 w-48 h-48 bg-purple-500/15 blur-3xl rounded-full group-hover:bg-purple-500/30 transition-all duration-500"
                >
                </div>
                <div
                    class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent pointer-events-none"
                >
                </div>

                <div class="relative z-10 mb-8">
                    <div
                        class="w-14 h-14 bg-slate-950 border border-slate-800 rounded-2xl flex items-center justify-center mb-6 shadow-[inset_0_-2px_0_#1e293b] group-hover:border-purple-400/50 transition-colors"
                    >
                        <svg
                            class="w-7 h-7 text-purple-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-bold text-white group-hover:text-purple-300 transition-colors"
                    >
                        Videollamada por Google Meet
                    </h3>
                    <p class="text-slate-400 text-sm mt-2 leading-relaxed">
                        Agenda una sesión directa de 15 minutos para revisar los
                        requerimientos de tu negocio y trazar el plan de acción.
                    </p>
                </div>

                <div
                    class="relative z-10 pt-4 border-t border-white/10 flex items-center justify-between text-sm font-semibold text-purple-300 group-hover:translate-x-1 transition-transform"
                >
                    <span>Agendar en Calendario</span>
                    <span class="text-lg">→</span>
                </div>
            </a>

            <!-- OPCIÓN 2: WHATSAPP DIRECTO (Cyan) -->
            <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative bg-gradient-to-b from-slate-900/90 via-slate-900/50 to-slate-950/30 backdrop-blur-md rounded-[2rem] p-8 md:p-10 border border-white/10 hover:border-cyan-500/40 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden shadow-2xl hover:shadow-cyan-500/10"
            >
                <div
                    class="absolute top-0 right-0 w-48 h-48 bg-cyan-500/15 blur-3xl rounded-full group-hover:bg-cyan-500/30 transition-all duration-500"
                >
                </div>
                <div
                    class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent pointer-events-none"
                >
                </div>

                <div class="relative z-10 mb-8">
                    <div
                        class="w-14 h-14 bg-slate-950 border border-slate-800 rounded-2xl flex items-center justify-center mb-6 shadow-[inset_0_-2px_0_#1e293b] group-hover:border-cyan-400/50 transition-colors"
                    >
                        <svg
                            class="w-7 h-7 text-cyan-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors"
                    >
                        WhatsApp Inmediato
                    </h3>
                    <p class="text-slate-400 text-sm mt-2 leading-relaxed">
                        ¿Tienes dudas rápidas sobre un paquete? Escríbenos un
                        mensaje directo y resolvemos tus preguntas al instante.
                    </p>
                </div>

                <div
                    class="relative z-10 pt-4 border-t border-white/10 flex items-center justify-between text-sm font-semibold text-cyan-300 group-hover:translate-x-1 transition-transform"
                >
                    <span>Abrir Chat de WhatsApp</span>
                    <span class="text-lg">→</span>
                </div>
            </a>
        </div>
    </div>
</section>

<style>
    .bg-grid-purple {
        background-size: 40px 40px;
        background-image:
            linear-gradient(
                to right,
                rgba(168, 85, 247, 0.08) 1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                rgba(168, 85, 247, 0.08) 1px,
                transparent 1px
            );
    }
</style>

---
// src/components/Services.astro
---

<section id="servicios" class="relative py-28 bg-slate-950 overflow-hidden">
    <!-- FONDOS Y EFECTOS DE LUZ -->
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 bg-grid-purple opacity-10"></div>
        <!-- Glow ambiental detrás de la sección -->
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-purple-900/20 blur-[150px] rounded-full"
        >
        </div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6">
        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="text-center mb-16">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-purple-950/50 border border-purple-500/20 backdrop-blur-md"
            >
                <span class="text-xs text-purple-300 font-mono">Alt + S</span>
                <span class="text-xs text-slate-400"
                    >• Soluciones Digitales</span
                >
            </div>
            <h2
                class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-4"
            >
                Servicios diseñados para <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-indigo-300 to-cyan-300"
                >
                    hacer crecer tu negocio.
                </span>
            </h2>
            <p class="text-slate-400 max-w-xl mx-auto text-sm md:text-base">
                Especializados en llevar tiendas locales y emprendimientos del
                mundo análogo al ecosistema digital.
            </p>
        </div>

        <!-- GRID DE TARJETAS ESTILO NEON UI -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- CARD 1: Digitalización y Redes (Resplandor Azul/Cyan) -->
            <div
                class="group relative bg-slate-900/90 rounded-[2rem] p-8 border border-white/10 hover:border-cyan-500/40 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden shadow-2xl"
            >
                <!-- Glow Neón Superior (Luz concentrada en la esquina superior izquierda) -->
                <div
                    class="absolute top-[-30px] left-[-30px] w-36 h-36 bg-blue-500/30 blur-2xl rounded-full group-hover:bg-blue-500/50 transition-all duration-500"
                >
                </div>

                <!-- Glow Neón Inferior (Resplandor estilo Neon UI) -->
                <div
                    class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-blue-600/40 via-cyan-500/20 to-transparent blur-xl group-hover:h-32 transition-all duration-500 pointer-events-none"
                >
                </div>

                <div>
                    <!-- Ícono con detalle Tecla -->
                    <div
                        class="relative w-12 h-12 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center mb-6 shadow-[inset_0_-2px_0_#1e293b] group-hover:border-cyan-400/50 transition-colors"
                    >
                        <svg
                            class="w-6 h-6 text-cyan-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors"
                    >
                        Digitalización & Redes
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-8">
                        Ingreso estratégico a redes sociales y Google Maps.
                        Conectamos tu punto de venta físico con clientes locales
                        en internet.
                    </p>
                </div>

                <div
                    class="relative z-10 flex items-center justify-between pt-4 border-t border-white/5"
                >
                    <span
                        class="text-xs font-mono text-cyan-400/80 bg-cyan-950/50 px-2 py-1 rounded border border-cyan-800/40"
                        >Alt + Impacto</span
                    >
                    <a
                        href="#contacto"
                        class="text-xs font-semibold text-white group-hover:translate-x-1 transition-transform flex items-center gap-1"
                    >
                        Saber más <span class="text-cyan-400">→</span>
                    </a>
                </div>
            </div>

            <!-- CARD 2: Desarrollo Web & E-Commerce (Resplandor Naranja/Ámbar) -->
            <div
                class="group relative bg-slate-900/90 rounded-[2rem] p-8 border border-white/10 hover:border-amber-500/40 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden shadow-2xl"
            >
                <!-- Glow Neón Superior -->
                <div
                    class="absolute top-[-30px] left-[-30px] w-36 h-36 bg-amber-500/30 blur-2xl rounded-full group-hover:bg-amber-500/50 transition-all duration-500"
                >
                </div>

                <!-- Glow Neón Inferior -->
                <div
                    class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-orange-600/40 via-amber-500/20 to-transparent blur-xl group-hover:h-32 transition-all duration-500 pointer-events-none"
                >
                </div>

                <div>
                    <div
                        class="relative w-12 h-12 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center mb-6 shadow-[inset_0_-2px_0_#1e293b] group-hover:border-amber-400/50 transition-colors"
                    >
                        <svg
                            class="w-6 h-6 text-amber-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                            ></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-bold text-white mb-3 group-hover:text-amber-300 transition-colors"
                    >
                        Web & E-Commerce
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-8">
                        Páginas de alto impacto y tiendas en línea ultra rápidas
                        optimizadas para convertir visitantes en ventas reales.
                    </p>
                </div>

                <div
                    class="relative z-10 flex items-center justify-between pt-4 border-t border-white/5"
                >
                    <span
                        class="text-xs font-mono text-amber-400/80 bg-amber-950/50 px-2 py-1 rounded border border-amber-800/40"
                        >Ctrl + Ventas</span
                    >
                    <a
                        href="#contacto"
                        class="text-xs font-semibold text-white group-hover:translate-x-1 transition-transform flex items-center gap-1"
                    >
                        Saber más <span class="text-amber-400">→</span>
                    </a>
                </div>
            </div>

            <!-- CARD 3: Automatización & Bots (Resplandor Violeta/Púrpura) -->
            <div
                class="group relative bg-slate-900/90 rounded-[2rem] p-8 border border-white/10 hover:border-purple-500/40 transition-all duration-500 hover:-translate-y-2 flex flex-col justify-between overflow-hidden shadow-2xl"
            >
                <!-- Glow Neón Superior -->
                <div
                    class="absolute top-[-30px] left-[-30px] w-36 h-36 bg-purple-500/30 blur-2xl rounded-full group-hover:bg-purple-500/50 transition-all duration-500"
                >
                </div>

                <!-- Glow Neón Inferior -->
                <div
                    class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-purple-600/50 via-fuchsia-500/20 to-transparent blur-xl group-hover:h-32 transition-all duration-500 pointer-events-none"
                >
                </div>

                <div>
                    <div
                        class="relative w-12 h-12 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center mb-6 shadow-[inset_0_-2px_0_#1e293b] group-hover:border-purple-400/50 transition-colors"
                    >
                        <svg
                            class="w-6 h-6 text-purple-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>

                    <h3
                        class="text-2xl font-bold text-white mb-3 group-hover:text-purple-300 transition-colors"
                    >
                        Automatización & Bots
                    </h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-8">
                        Implementación de chatbots inteligentes para WhatsApp y
                        procesos automáticos para atender a tus clientes 24/7.
                    </p>
                </div>

                <div
                    class="relative z-10 flex items-center justify-between pt-4 border-t border-white/5"
                >
                    <span
                        class="text-xs font-mono text-purple-400/80 bg-purple-950/50 px-2 py-1 rounded border border-purple-800/40"
                        >Shift + Tiempo</span
                    >
                    <a
                        href="#contacto"
                        class="text-xs font-semibold text-white group-hover:translate-x-1 transition-transform flex items-center gap-1"
                    >
                        Saber más <span class="text-purple-400">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-grid-purple {
        background-size: 40px 40px;
        background-image:
            linear-gradient(
                to right,
                rgba(168, 85, 247, 0.08) 1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                rgba(168, 85, 247, 0.08) 1px,
                transparent 1px
            );
    }
</style>

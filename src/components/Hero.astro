---
// src/components/Hero.astro
---

<section class="relative min-h-screen bg-slate-950 pt-36 pb-20 overflow-hidden flex flex-col justify-between">
  
  <!-- FONDOS Y EFECTOS DE LUZ (Glow Neón Violeta) -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Grid sutil de fondo -->
    <div class="absolute inset-0 bg-grid-purple opacity-15"></div>
    <!-- Luz curva superior tipo domo violeta -->
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-purple-600/40 via-indigo-600/20 to-transparent blur-[120px] rounded-full"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    
    <!-- BADGE NOVEDAD / TECLA -->
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-8 rounded-full bg-purple-950/60 border border-purple-500/30 backdrop-blur-md shadow-[0_0_15px_rgba(168,85,247,0.2)]">
      <span class="px-1.5 py-0.5 bg-purple-500/20 text-purple-300 font-mono text-[10px] rounded border border-purple-400/30">Ctrl + Shift</span>
      <span class="text-xs text-purple-200">De lo Análogo a lo Digital</span>
    </div>

    <!-- TÍTULO PRINCIPAL -->
    <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
      Transforma tu negocio local.<br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-300 via-indigo-300 to-cyan-300 drop-shadow-[0_0_35px_rgba(168,85,247,0.6)]">
        Estrategia Digital & Desarrollo Web.
      </span>
    </h1>

    <!-- SUBTÍTULO -->
    <p class="text-slate-400 text-base md:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
      Llevamos tu tienda física al entorno digital. Construimos sitios web, e-commerces y automatizaciones rápidas que escalan tus ventas.
    </p>

    <!-- BOTONES DE ACCIÓN (Estilo Plantilla) -->
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-20">
      <a href="#contacto" class="w-full sm:w-auto bg-white text-slate-950 px-6 py-3 rounded-full font-bold text-sm hover:bg-slate-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.3)] flex items-center justify-center gap-2">
        Agendar una Demo <span>→</span>
      </a>
      <a href="#servicios" class="w-full sm:w-auto bg-purple-950/40 border border-purple-500/40 text-purple-200 px-6 py-3 rounded-full font-semibold text-sm hover:border-purple-400 hover:bg-purple-900/30 transition-all backdrop-blur-md">
        Explorar Servicios
      </a>
    </div>

    <!-- SECCIÓN DE MÉTRICAS / STATS BAR -->
    <div class="relative py-8 my-8 border-y border-purple-500/10 bg-slate-950/40 backdrop-blur-sm">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-3xl font-extrabold text-white font-mono">100%</p>
          <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">Disponibilidad</p>
        </div>
        <div>
          <p class="text-3xl font-extrabold text-purple-400 font-mono">24/7</p>
          <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">Atención automatizada</p>
        </div>
        <div>
          <p class="text-3xl font-extrabold text-white font-mono">&lt; 1s</p>
          <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">Carga Ultra Rápida</p>
        </div>
        <div>
          <p class="text-3xl font-extrabold text-indigo-400 font-mono">3x</p>
          <p class="text-xs text-slate-500 uppercase tracking-wider mt-1">Mayor Alcance</p>
        </div>
      </div>
    </div>

    <!-- SECCIÓN SOCIAL PROOF / LOGOS -->
    <div class="pt-8">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-6">
        Impulsando la digitalización de marcas y locales
      </p>
      
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-50 grayscale hover:grayscale-0 transition-all">
        <span class="font-bold text-slate-400 text-sm tracking-wider">MARCA 01</span>
        <span class="font-bold text-slate-400 text-sm tracking-wider">LOCAL STUDIO</span>
        <span class="font-bold text-slate-400 text-sm tracking-wider">E-COMMERCE CO</span>
        <span class="font-bold text-slate-400 text-sm tracking-wider">AGENCY HUB</span>
        <span class="font-bold text-slate-400 text-sm tracking-wider">SaaS TECH</span>
      </div>
    </div>

  </div>
</section>

<style>
  .bg-grid-purple {
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(168, 85, 247, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(168, 85, 247, 0.1) 1px, transparent 1px);
  }
</style>
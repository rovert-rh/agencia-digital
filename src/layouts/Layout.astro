---
interface Props {
	title: string;
}
const { title } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body
		class="bg-slate-950 text-slate-200 overflow-x-hidden font-sans antialiased"
	>
		<slot />
	</body>
</html>

<style is:global>
	.tecla-animada {
		position: relative;
		width: 72px;
		height: 72px;
		background: #0f172a;
		border-radius: 8px;
		border: 1px solid #1e293b;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.1),
			0 8px 0 #020617,
			0 15px 25px rgba(0, 0, 0, 0.5);
		animation: press-key 3s infinite;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.delay-100 {
		animation-delay: 0.2s;
	}
	.delay-200 {
		animation-delay: 0.4s;
	}

	@keyframes press-key {
		0%,
		20%,
		100% {
			transform: translateY(0);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 8px 0 #020617,
				0 15px 25px rgba(0, 0, 0, 0.5);
		}
		10% {
			transform: translateY(6px);
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 2px 0 #020617,
				0 0px 25px rgba(6, 182, 212, 0.8);
			border-color: rgba(6, 182, 212, 0.6);
		}
	}
</style>
